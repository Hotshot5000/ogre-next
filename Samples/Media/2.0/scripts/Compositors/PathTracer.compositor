compositor_node PathTracerRenderingNode
{
    in 0 rt_renderwindow

    texture accumulationTexture target_width target_height PFG_RGBA32_FLOAT depth_pool 0 uav keep_content
    texture radianceTexture target_width target_height PFG_RGBA16_FLOAT depth_pool 0 uav
    texture denoisedRadianceTexture target_width target_height PFG_RGBA16_FLOAT depth_pool 0 uav keep_content
    texture pathTracerDepthTexture target_width target_height PFG_R32_FLOAT depth_pool 0 uav
    texture pathTracerMotionTexture target_width target_height PFG_RG16_FLOAT depth_pool 0 uav
    texture pathTracerNormalTexture target_width target_height PFG_RGBA16_FLOAT depth_pool 0 uav
    texture pathTracerDiffuseAlbedoTexture target_width target_height PFG_RGBA16_FLOAT depth_pool 0 uav
    texture pathTracerSpecularAlbedoTexture target_width target_height PFG_RGBA16_FLOAT depth_pool 0 uav
    texture pathTracerRoughnessTexture target_width target_height PFG_R16_FLOAT depth_pool 0 uav
    texture pathTracerSpecularHitDistanceTexture target_width target_height PFG_R16_FLOAT depth_pool 0 uav

    target
    {
        pass compute
        {
            job PathTracing/TraceJob

            uav 0 accumulationTexture read write
            uav 1 radianceTexture write
            uav 2 pathTracerDepthTexture write
            uav 3 pathTracerMotionTexture write
            uav 4 pathTracerNormalTexture write
            uav 5 pathTracerDiffuseAlbedoTexture write
            uav 6 pathTracerSpecularAlbedoTexture write
            uav 7 pathTracerRoughnessTexture write
            uav 8 pathTracerSpecularHitDistanceTexture write
        }
    }

    target rt_renderwindow
    {
        pass clear
        {
            colour_value 0.02 0.025 0.03 1
        }

        pass render_quad
        {
            material PathTracing/Resolve
            input 0 denoisedRadianceTexture
        }

        pass render_scene
        {
            lod_update_list false
            overlays on
            rq_first 254
            rq_last 255
        }
    }
}

workspace PathTracerWorkspace
{
    connect_output PathTracerRenderingNode 0
}
