fragment_program PathTracingResolve_ps_Metal metal
{
    source PathTracingResolve_ps.metal
    shader_reflection_pair_hint Ogre/Compositor/Quad_vs
}

fragment_program PathTracingResolve_ps unified
{
    delegate PathTracingResolve_ps_Metal

    default_params
    {
        param_named useFallbackDenoiser float 1.0
    }
}

fragment_program PathTracingCopy_ps_Metal metal
{
    source PathTracingCopy_ps.metal
    shader_reflection_pair_hint Ogre/Compositor/Quad_vs
}

fragment_program PathTracingCopy_ps unified
{
    delegate PathTracingCopy_ps_Metal
}

material PathTracing/Resolve
{
    technique
    {
        pass
        {
            depth_check off
            depth_write off
            scene_blend one zero
            cull_hardware none

            vertex_program_ref Ogre/Compositor/Quad_vs
            {
            }

            fragment_program_ref PathTracingResolve_ps
            {
            }

            texture_unit radianceTexture
            {
                tex_address_mode clamp
                filtering bilinear
            }
        }
    }
}

material PathTracing/Copy
{
    technique
    {
        pass
        {
            depth_check off
            depth_write off
            scene_blend one zero
            cull_hardware none

            vertex_program_ref Ogre/Compositor/Quad_vs
            {
            }

            fragment_program_ref PathTracingCopy_ps
            {
            }

            texture_unit sceneTexture
            {
                tex_address_mode clamp
                filtering point point none
            }
        }
    }
}
